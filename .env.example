# ---------------------------------------------------------------------------
# Contact form — Gmail SMTP (server-side only)
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# git-ignored; never commit credentials.
#
# EMAIL_PASSWORD must be a Google App Password (16 characters), not your
# account password. Generate one at https://myaccount.google.com/apppasswords
# with 2-Step Verification enabled.
#
# None of these are prefixed with NEXT_PUBLIC_, so they are only ever readable
# by server-side code. Do not add that prefix.
# ---------------------------------------------------------------------------

# The Gmail account used to send the message.
EMAIL_USER=your-email@gmail.com

# Google App Password for the account above.
EMAIL_PASSWORD=your-16-character-app-password

# Where enquiries should be delivered. Defaults to EMAIL_USER if omitted.
CONTACT_EMAIL=your-email@gmail.com

